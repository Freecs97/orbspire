[resource]
script = ExtResource("1_ad")
act_number = 1
colony_name = "Orbspire"
colony_kind = "Furnace Colony"
singularity_name = "Emberfang-9"
singularity_kind = "Plasma Wolf"
element = 0
fights = Array[Resource]([ExtResource("f1"), ExtResource("f2"), ExtResource("f3"), ExtResource("f4"), ExtResource("f5"), ExtResource("f6"), ExtResource("f7"), ExtResource("f8")])
arena = ExtResource("2_arena")
boss_art = ExtResource("3_boss")
intel_lines = Array[String](["Orbspire was built to burn: its furnace heats every colony on this edge of the map.", "Emberfang-9, the First Splice, took the furnace and guards the heat as its own.", "The Progenitors quarantined Orbspire and ration its heat by the hour."])
intro_lines = Array[String](["Orbspire was built to burn. Its furnace was spliced with a wolf to guard it.", "The wolf learned to guard something else instead."])
boss_taunt = "You did not make me. But you made what made me."
outro_line = "The furnace keeps burning. The colony keeps rationing heat. Killing the wolf did not fix Orbspire. It only proved the wolf could be killed."
intro_seconds = 10.0
taunt_seconds = 5.0
outro_seconds = 10.0
codex_spliced_from = "A grey wolf and the plasma conduits of Orbspire's furnace. The First Splice, Year 82, made by the Progenitors to guard the heat."
codex_wanted = "To guard. When the Progenitors banned it, it kept guarding, but not for them. It guarded the furnace from everyone, the Progenitors included."
codex_cost = "Its memory of being a wolf. The furnace crews who tried to take the heat back. And the Progenitors' secret, now on the record: the first singularity was theirs."