[resource]
script = ExtResource("1_ad")
act_number = 9
colony_name = "Core Sanctum"
colony_kind = "Progenitor Headquarters"
singularity_name = "Seraph Enforcer"
singularity_kind = "Android Knight"
element = 5
fights = Array[ExtResource("3_3nq5o")]([ExtResource("4_pf3ce"), ExtResource("5_u6seb"), ExtResource("6_huaic"), ExtResource("7_5hbop"), ExtResource("8_53alh"), ExtResource("9_rpbuh"), ExtResource("10_6od56"), ExtResource("11_su5s1")])
arena = ExtResource("1_o5nqy")
boss_art = ExtResource("2_jvu7h")
intel_lines = Array[String](["The Core Sanctum is where the Progenitors rule from, with ledgers, not soldiers.", "The Seraph Enforcer, an angelic android knight, judges everyone who enters the Sanctum.", "The Progenitors built it to enforce their law. It enforces it on them too."])
intro_lines = Array[String](["The Core Sanctum is where the Progenitors rule, with ledgers, not soldiers.", "The Seraph Enforcer was built to carry out their law. Its quarantine is now closing in on the Sanctum itself."])
boss_taunt = "Under the law of Year 121, all that technomancy has touched is erased. You have touched eight singularities. Sentence follows."
outro_line = "The Seraph signed the order. Under its law, anyone who has touched technomancy is sealed away: the lab staff, the colonies, and now the Sanctum's own halls.
The ledgers cannot hold any more. The quarantine is closing in on the people who wrote it.
Only one world in the ledger is marked never to be judged: the Core."
taunt_seconds = 7.0
outro_seconds = 16.0
codex_colony = "The seat of the Progenitors, who rule with ledgers, not soldiers."
codex_rationed = "Every colony's heat, water, light and silence was signed off here."
codex_spliced_from = "A cathedral guardian android and the Sanctum's ledger engine, made on the day the law was signed, Year 121."
codex_abandoned = "Left to run the ledgers alone when the Progenitors stopped coming to the Sanctum. It kept judging, all the way to their own doors."
