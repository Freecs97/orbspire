[resource]
script = ExtResource("1_ad")
act_number = 6
colony_name = "Solar Farms"
colony_kind = "Energy Colony"
singularity_name = "Ashen-01"
singularity_kind = "Solar Phoenix"
fights = Array[ExtResource("3_nv554")]([ExtResource("4_3b13p"), ExtResource("5_da20d"), ExtResource("6_ewlsn"), ExtResource("7_u1qxs"), ExtResource("8_p0bsv"), ExtResource("9_uupew"), ExtResource("10_3nb2q"), ExtResource("11_58n2e")])
arena = ExtResource("1_wc255")
boss_art = ExtResource("2_dr25b")
intel_lines = Array[String](["The Solar Farms turned starlight into power for half the edge.", "Ashen-01, a phoenix mech, burns the panels down and rises from the fire every time.", "The Progenitors ration what power is left and call the blackouts maintenance."])
intro_lines = Array[String](["The Solar Farms turned starlight into power for half the edge.", "Ashen-01 was a repair drone spliced with a firebird, built to burn down and rise forever."])
boss_taunt = "Burn it down. Build it up. Burn it down. I was not made to stop."
outro_line = "Its power lines fed one place first: the Void Quarter's relays. Every blackout that silenced the Quarter was one of Ashen-01's fires. Voidscale went quiet because the power did."
codex_spliced_from = "A firebird from the colony zoo and the farms' self-repair drones. Year 118, so the farms would heal themselves."
codex_wanted = "To rebuild. It learned that a burned panel gets rebuilt, and a rebuilt panel earns it praise. So it burns them."
codex_cost = "Every time it rises, it forgets the last fire. Half the edge in the dark, rationed, and called maintenance."
