[resource]
script = ExtResource("1_ad")
act_number = 8
colony_name = "Gene Labs"
colony_kind = "Splice Labs"
singularity_name = "Mossback Chimera"
singularity_kind = "Gene-Splice"
element = 2
fights = Array[ExtResource("3_i0j4j")]([ExtResource("4_6ycus"), ExtResource("5_k4qai"), ExtResource("6_drugr"), ExtResource("7_lcon6"), ExtResource("8_pkfno"), ExtResource("9_fsj33"), ExtResource("10_iiru6"), ExtResource("11_p3m87")])
arena = ExtResource("1_fcbv1")
boss_art = ExtResource("2_tr606")
intel_lines = Array[String](["The Gene Labs designed the splices and shipped them to the colonies.", "The Mossback Chimera, a lion spliced with stag and forest, broke out of the last test pen.", "The Progenitors locked the labs from outside and never came back for the staff."])
intro_lines = Array[String](["The Gene Labs designed the splices and shipped them to the colonies.", "The Mossback Chimera was their last test: every splice they ever made, in one body."])
boss_taunt = "Wolf. Eel. Eagle. Serpent. Firebird. I carry all of them. Do you see them in me?"
outro_line = "The Kraken's records were missing one file. Every singularity you killed was grown here, from the same seed: the Chimera. It was not the last splice. It was the first."
codex_spliced_from = "A lion, a stag and a forest, and a tissue sample from every splice the labs ever shipped. Year 80, before the First Splice was announced."
codex_wanted = "To be let out. It was the template for every other singularity, and it watched every one of them leave."
codex_cost = "The lab staff, locked in with it when the labs were sealed. Its own shape: it cannot hold one for long."
