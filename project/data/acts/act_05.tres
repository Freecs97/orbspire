[resource]
script = ExtResource("1_ad")
act_number = 5
colony_name = "Void Quarter"
colony_kind = "Dead-Network Colony"
singularity_name = "Voidscale"
singularity_kind = "Stealth Dragon"
element = 6
fights = Array[ExtResource("3_l8urc")]([ExtResource("4_uwx82"), ExtResource("5_v1lq5"), ExtResource("6_4abwr"), ExtResource("7_03mc7"), ExtResource("8_ixggk"), ExtResource("9_17vmr"), ExtResource("10_rgcbn"), ExtResource("11_tikk7")])
arena = ExtResource("1_c6vq5")
boss_art = ExtResource("2_yfn43")
intel_lines = Array[String](["The Void Quarter ran the network that kept the colonies talking.", "Voidscale, a stealth dragon, swallowed the signal and went silent with it.", "The Progenitors cut the Quarter's power and erased it from the maps."])
intro_lines = Array[String](["The Void Quarter carried every message between the colonies.", "Voidscale was spliced to make messages disappear. After Year 121, it made the whole network disappear."])
boss_taunt = "You hear nothing. That is how I know I am working."
outro_line = "In Voidscale's silence: every reply the colonies ever sent up to the Spires. Not one arrived.
Outlawing technomancy did not stop a single splice. It made speaking of one a crime, so no colony could ever compare what had been done to it.
Every colony's last message is stamped with the same hour: the hour the lights went out."
outro_seconds = 16.0
codex_colony = "Relay halls that carried every message between the colonies."
codex_rationed = "Contact. After Year 121, any message that mentioned a splice was a crime."
codex_spliced_from = "A cave serpent that hunts in silence and the Quarter's signal relays, Year 114, to make messages disappear."
codex_abandoned = "Its power was cut and the Quarter was erased from the maps. It still holds every message it swallowed, unread."
