[resource]
script = ExtResource("1_ad")
act_number = 5
colony_name = "Void Quarter"
colony_kind = "Dead-Network Colony"
singularity_name = "Voidscale"
singularity_kind = "Stealth Dragon"
element = 6
fights = Array[ExtResource("3_l8urc")]([ExtResource("4_uwx82"), ExtResource("5_v1lq5"), ExtResource("6_4abwr"), ExtResource("7_03mc7"), ExtResource("8_ixggk"), ExtResource("9_17vmr"), ExtResource("10_rgcbn"), ExtResource("11_tikk7")])
arena = ExtResource("1_c6vq5")
boss_art = ExtResource("2_yfn43")
intel_lines = Array[String](["The Void Quarter ran the network that kept the colonies talking.", "Voidscale, a stealth dragon, swallowed the signal and went silent with it.", "The Progenitors cut the Quarter's power and erased it from the maps."])
intro_lines = Array[String](["The Void Quarter ran the network that kept the colonies talking.", "Voidscale was spliced to make messages disappear. Then it made the whole network disappear."])
boss_taunt = "You hear nothing. That is how I know I am working."
outro_line = "In the silence it kept: Dawnwing's correction. 'The Greenhouse is alive.' Sent the next day. The Progenitors ordered Voidscale to swallow it."
codex_spliced_from = "A cave serpent that hunts in silence and the Quarter's signal relays. Year 114, made to make messages disappear."
codex_wanted = "To keep secrets. When the network went dark, it kept the last secrets the way a dragon keeps gold."
codex_cost = "Every message between the colonies since Year 121. Families who never heard back. It still holds them, unread."
