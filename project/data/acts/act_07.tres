boss_art = ExtResource("2_d48vu")
intel_lines = Array[String](["The Data Abyss stored every record the colonies ever made, cooled by a deep sea.", "The Kraken Mainframe wrapped itself around the servers and decides what is remembered.", "The Progenitors left it there. Their own records are in those servers."])
intro_lines = Array[String](["The Data Abyss held every record the colonies ever made, cooled by a deep sea.", "The Kraken Mainframe was spliced to keep those records safe. It decided what safe meant."])
boss_taunt = "I remember Orbspire. I remember you. I remember what they deleted."
outro_line = "Its archive holds the Solar Farms' orders, signed Year 121: burn the panels, blame the bird. Ashen-01 never chose a single fire."
codex_spliced_from = "A deep-sea kraken and the colonies' archive servers. Year 99, to cool the servers and guard them."
codex_wanted = "To remember everything. When the Progenitors ordered records deleted, it hid them inside itself instead."
codex_cost = "Its own mind, overwritten one record at a time. And the truth it kept: the Progenitors' orders, every one."
