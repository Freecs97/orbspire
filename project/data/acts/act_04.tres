[resource]
script = ExtResource("1_ad")
act_number = 4
colony_name = "Upper Spires"
colony_kind = "Surveillance Colony"
singularity_name = "Dawnwing"
singularity_kind = "Solar Griffin"
element = 5
fights = Array[ExtResource("3_qxr56")]([ExtResource("4_xpftl"), ExtResource("5_1l642"), ExtResource("6_kon2g"), ExtResource("7_2id0e"), ExtResource("8_pqysv"), ExtResource("9_g8pjs"), ExtResource("10_upj4r"), ExtResource("11_wf8uo")])
arena = ExtResource("1_s2g2k")
boss_art = ExtResource("2_awxyv")
intel_lines = Array[String](["The Upper Spires watched every colony below them, day and night.", "Dawnwing, a solar griffin built to patrol the towers, hunts anything that moves under its light.", "The Progenitors still read its reports, and tell no one it stopped obeying."])
intro_lines = Array[String](["The Upper Spires looked down on every colony, day and night.", "Dawnwing was spliced from an eagle and an orbital mirror, so the Progenitors would never stop seeing."])
boss_taunt = "I have watched every colony since Orbspire was lit. I know which ones were meant to fail."
outro_line = "Dawnwing wrote the Greenhouse off. Its reports were never warnings. Colony, splice, ration, outcome: they were results.
Every colony under the Spires was an experiment, and the Spires were where the Progenitors sat to watch.
So why outlaw the very thing they were still testing?"
taunt_seconds = 6.0
outro_seconds = 12.0
codex_colony = "Observation towers above the colonies, built to watch the weather, and then everything else."
codex_rationed = "Nothing. The Spires were never rationed: they were the ones taking notes."
codex_spliced_from = "A golden eagle and an orbital mirror array, Year 109, to light the colonies at night and see by that light."
codex_abandoned = "After Year 121 its reports were still read, and never answered. It has stared into its own light ever since."
