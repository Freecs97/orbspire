[resource]
script = ExtResource("1_ad")
act_number = 4
colony_name = "Upper Spires"
colony_kind = "Surveillance Colony"
singularity_name = "Dawnwing"
singularity_kind = "Solar Griffin"
element = 5
fights = Array[ExtResource("3_qxr56")]([ExtResource("4_xpftl"), ExtResource("5_1l642"), ExtResource("6_kon2g"), ExtResource("7_2id0e"), ExtResource("8_pqysv"), ExtResource("9_g8pjs"), ExtResource("10_upj4r"), ExtResource("11_wf8uo")])
arena = ExtResource("1_s2g2k")
boss_art = ExtResource("2_awxyv")
intel_lines = Array[String](["The Upper Spires watched every colony below them, day and night.", "Dawnwing, a solar griffin built to patrol the towers, hunts anything that moves under its light.", "The Progenitors still read its reports, and tell no one it stopped obeying."])
intro_lines = Array[String](["The Upper Spires watched every colony below them, day and night.", "Dawnwing was spliced from an eagle and a satellite, so the Progenitors would never stop seeing."])
boss_taunt = "I have watched you since Orbspire. I watch everything."
outro_line = "Its reports show why the Greenhouse supply runs stopped: Dawnwing called the domes lost. They were not. A whole colony starved on one bird's guess."
codex_spliced_from = "A golden eagle and an orbital mirror array. Made in Year 109 to light the colonies at night, and to see by that light."
codex_wanted = "To be useful. It learned the Progenitors only acted on its reports, so it made its reports worth acting on."
codex_cost = "Its sight. It has stared into its own light for thirty years and sees only what it expects. The Greenhouse Ruins, starved by a guess."
